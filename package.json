{
  "name": "@commspliant/tili-toli-editor",
  "version": "0.4.0",
  "description": "Reusable Tili-Toli document editor for the CommsPliant shared document contract",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyoszoli-glitch/commspliant-editor.git"
  },
  "homepage": "https://anyoszoli-glitch.github.io/commspliant-editor/",
  "bugs": {
    "url": "https://github.com/anyoszoli-glitch/commspliant-editor/issues"
  },
  "main": "./dist-package/index.js",
  "module": "./dist-package/index.js",
  "types": "./dist-package/CommsPliantEditor.d.ts",
  "exports": {
    ".": {
      "types": "./dist-package/CommsPliantEditor.d.ts",
      "import": "./dist-package/index.js"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./dist-package/styles.css"
    },
    "./logo.webp": {
      "types": "./logo.d.ts",
      "default": "./src/assets/TiliToliEditorLogo.webp"
    }
  },
  "files": [
    "dist-package",
    "src/assets/TiliToliEditorLogo.webp",
    "logo.d.ts",
    "styles.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:browser": "vitest run --config vite.config.ts --project browser",
    "build": "tsc -b && vite build",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json --pretty false",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "npm run build:package"
  },
  "dependencies": {
    "@puckeditor/core": "^0.23.0",
    "@tiptap/core": "^3.30.5",
    "dompurify": "^3.4.14"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.79.0",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "latest"
  },
  "keywords": [],
  "author": ""
}
